#!/usr/bin/env bash
# Enable once: git config core.hooksPath .githooks
# Full dual-verify also runs in GitHub Actions (qa-gate) on every push/PR.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] QA wiring check..."
python3 scripts/verify_qa_automation.py
echo "[pre-push] OK — CI qa-gate runs the full dual gate on this push"
